    <!-- Privacy Info Screen -->
    <string name="privacy_title">Privacy &amp; Security</string>
    <string name="privacy_hero_title">100% Local-First Architecture</string>
    <string name="privacy_hero_body">Smart Dialer Pro runs entirely on your device. There are no cloud servers, no analytics trackers, and no external contact or call log uploads.</string>
    <string name="privacy_perm_contacts_title">Contacts Permission</string>
    <string name="privacy_perm_contacts_desc">Used strictly to display your contacts, favorites, T9 keypad suggestions, and save edits you explicitly confirm.</string>
    <string name="privacy_perm_call_log_title">Call Log Permission</string>
    <string name="privacy_perm_call_log_desc">Used strictly to read and filter real call history records stored by Android on your device.</string>
    <string name="privacy_perm_phone_title">Phone &amp; SIM State Permission</string>
    <string name="privacy_perm_phone_desc">Used to place calls when permitted and detect multi-SIM slots on dual-SIM devices.</string>
    <string name="privacy_logging_title">Zero Sensitive Logging</string>
    <string name="privacy_logging_desc">Phone numbers, contact names, and call logs are never written to diagnostic logs or shared outside Android\'s local ContentProviders.</string>

